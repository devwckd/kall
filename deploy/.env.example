# Copy to .env (never commit it: it holds the Cloudflare token).

# What friends see as the server's name.
KALL_NAME=The Basement

# Public name of the server. It gets a DNS-only (grey cloud) A record pointing at your home IP.
KALL_DOMAIN=kall.example.com

# Cloudflare API token with Zone → DNS → Edit and Zone → Zone → Read on that domain's zone.
# Enables the Let's Encrypt certificate (DNS-01) and keeps the A record on your current IP.
CF_API_TOKEN=

# Optional: Let's Encrypt emails this address about expiring certificates.
KALL_ACME_EMAIL=

# Try with the staging CA first (its certificates aren't trusted by clients); set to 0 once it works.
KALL_ACME_STAGING=1

# Set to 0 if you manage the A record yourself; 1 to also publish an AAAA (IPv6) record.
KALL_DDNS=1
KALL_DDNS_IPV6=0

# Files shared in chat: the largest allowed (MB), and how many days they're kept (0 = forever).
# They're stored in the data volume, next to the database.
KALL_MAX_FILE_MB=100
KALL_FILE_DAYS=30
